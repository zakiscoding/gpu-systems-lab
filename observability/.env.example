# Copy to .env on the GPU node (never commit .env).
#   cp .env.example .env && sed -i "s/^GF_SECURITY_ADMIN_PASSWORD=.*/GF_SECURITY_ADMIN_PASSWORD=$(openssl rand -hex 16)/" .env
# Address the published ports bind to. Tailscale IP of zak-gpu-node; use 127.0.0.1 for local-only.
BIND_IP=100.121.51.35
# Grafana admin password (anonymous users get read-only Viewer access).
GF_SECURITY_ADMIN_PASSWORD=change-me
