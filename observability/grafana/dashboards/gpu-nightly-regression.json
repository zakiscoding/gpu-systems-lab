{
 "title": "GPU nightly regression",
 "uid": "gpu-nightly-regression",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "refresh": "5m",
 "tags": [
  "gpu",
  "regression"
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Regression flag (last nightly run, >5% below 7-run median)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 16,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OK"
        },
        "1": {
         "text": "REGRESSION"
        }
       }
      }
     ]
    }
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "gg_nightly_regression{label=\"\"}",
     "legendFormat": "{{precision}}"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Hours since last nightly run",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(time() - gg_nightly_last_run_timestamp_seconds) / 3600"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 48
       }
      ]
     }
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Matmul TFLOPS by precision vs baseline (nightly, via GopherGrid)",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "gg_nightly_tflops{label=\"\"}",
     "legendFormat": "{{precision}}"
    },
    {
     "refId": "B",
     "expr": "gg_nightly_baseline_tflops{label=\"\"}",
     "legendFormat": "{{precision}} baseline"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Ratio to baseline (red line = 0.95)",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "gg_nightly_tflops{label=\"\"} / gg_nightly_baseline_tflops{label=\"\"}",
     "legendFormat": "{{precision}}"
    }
   ]
  }
 ]
}