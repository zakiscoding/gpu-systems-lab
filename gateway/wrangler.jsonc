// Serves on workers.dev until a domain is added (see README.md).
// Secrets, set with `wrangler secret put`: VLLM_API_KEY, GATEWAY_KEYS.
{
  "name": "vllm-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vpc_services": [
    { "binding": "VLLM", "service_id": "01a1a9b4-e111-76e1-b5cb-253423426be8", "remote": true },
    // Traces: OTLP/HTTP to the OpenTelemetry Collector on the iMac (tunnel mos-imac). Optional;
    // without it the Worker does not trace (src/tracing.js).
    { "binding": "OTEL", "service_id": "01a1d7f2-8e19-7390-b93b-370c6a51865f", "remote": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CLIENT_LIMITER", "class_name": "ClientRateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClientRateLimiter"] }],
  "ai": { "binding": "AI" },
  "vars": {
    "RATE_LIMIT_PER_MINUTE": "60",
    "MAX_BODY_BYTES": "262144",
    "MAX_TOKENS": "1024",
    "FALLBACK_MODEL": "@cf/meta/llama-3.2-3b-instruct"
  }
}
